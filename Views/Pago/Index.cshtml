@model IEnumerable<AnaYAntonio_ProyectoInmobiliaria.Models.Pago>

@{
    ViewData["Title"] = "Gestión de Pagos";
}

<style>
    body {
        background-color: #f5f7fa;
    }

    .card {
        border-radius: 10px;
        overflow: hidden;
    }

    .card-header {
        border-top: 4px solid #0d6efd;
    }

    .table thead th {
        background-color: #f8f9fa;
        font-size: 0.8rem;
        letter-spacing: 0.5px;
    }

    .table tbody tr {
        transition: background-color 0.2s ease;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Gestión de Pagos</h2>

            <p class="text-muted mb-0">
                Administre los pagos correspondientes a las reservas.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4 py-2">
            <span class="me-1">+</span> Nuevo Pago
        </a>

    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4"
             role="alert">

            <strong>¡Operación realizada correctamente!</strong>
            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    <div class="card shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-semibold">
                    Listado de Pagos
                </h5>

                <span class="text-muted small">
                    @ViewBag.CantidadTotal pago(s)
                </span>

            </div>

        </div>

        <!-- BUSCADOR -->
        <div class="card-body bg-white border-bottom">

            <form method="get" asp-action="Index">

                <div class="row g-2">

                    <div class="col-md-10">

                        <input type="text"
                               name="buscar"
                               value="@ViewBag.Buscar"
                               class="form-control"
                               placeholder="Buscar por código de pago, código de reserva o concepto..." />

                    </div>

                    <div class="col-md-2 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            Buscar
                        </button>

                        @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar))
                        {
                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Limpiar
                            </a>
                        }

                    </div>

                </div>

            </form>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>

                        <th class="ps-4">
                            Código
                        </th>

                        <th>
                            Reserva
                        </th>

                        <th>
                            Concepto
                        </th>

                        <th>
                            Fecha de pago
                        </th>

                        <th>
                            Monto
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-end pe-4">
                            Acciones
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="7" class="text-center py-5">

                                <div class="text-muted">

                                    @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar))
                                    {
                                        <h6 class="mb-2">
                                            No se encontraron pagos.
                                        </h6>

                                        <p class="mb-0">
                                            No hay pagos que coincidan con
                                            "<strong>@ViewBag.Buscar</strong>".
                                        </p>
                                    }
                                    else
                                    {
                                        <h6 class="mb-2">
                                            No hay pagos registrados.
                                        </h6>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var pago in Model)
                        {
                            <tr>

                                <td class="ps-4">

                                    <span class="text-muted">
                                        #@pago.ID_pago
                                    </span>

                                </td>

                                <td>
                                    Reserva #@pago.ID_reserva
                                </td>

                                <td>
                                    @pago.Concepto
                                </td>

                                <td>
                                    @pago.FechaPago.ToString("dd/MM/yyyy")
                                </td>

                                <td>

                                    <strong>
                                        $@pago.Monto.ToString("N2")
                                    </strong>

                                </td>

                                <td>

                                    @if (pago.Estado)
                                    {
                                        <span class="badge rounded-pill bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td class="text-end pe-4">

                                    <a asp-action="Details"
                                       asp-route-id="@pago.ID_pago"
                                       class="btn btn-info btn-sm">
                                        Detalle
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@pago.ID_pago"
                                       class="btn btn-outline-primary btn-sm ms-1">
                                        Modificar
                                    </a>

                                    @if (pago.Estado)
                                    {
                                        <form asp-action="Delete"
                                              asp-route-id="@pago.ID_pago"
                                              method="post"
                                              class="d-inline">

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm ms-1">
                                                Dar de baja
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate"
                                              asp-route-id="@pago.ID_pago"
                                              method="post"
                                              class="d-inline">

                                            <button type="submit"
                                                    class="btn btn-outline-success btn-sm ms-1">
                                                Dar de alta
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

        <!-- PAGINACIÓN -->
        @if (ViewBag.CantidadPaginas > 1)
        {
            <div class="card-footer bg-white">

                <nav aria-label="Paginación de pagos">

                    <ul class="pagination justify-content-center mb-0">

                        <!-- ANTERIOR -->
                        <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual - 1)"
                               asp-route-buscar="@ViewBag.Buscar">

                                Anterior

                            </a>

                        </li>

                        <!-- NÚMEROS DE PÁGINA -->
                        @for (int i = 1; i <= ViewBag.CantidadPaginas; i++)
                        {
                            <li class="page-item @(ViewBag.PaginaActual == i ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@i"
                                   asp-route-buscar="@ViewBag.Buscar">

                                    @i

                                </a>

                            </li>
                        }

                        <!-- SIGUIENTE -->
                        <li class="page-item @(ViewBag.PaginaActual == ViewBag.CantidadPaginas ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual + 1)"
                               asp-route-buscar="@ViewBag.Buscar">

                                Siguiente

                            </a>

                        </li>

                    </ul>

                </nav>

            </div>
        }

    </div>

</div>