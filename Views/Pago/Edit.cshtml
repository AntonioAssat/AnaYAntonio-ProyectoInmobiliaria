@model AnaYAntonio_ProyectoInmobiliaria.Models.Pago

@{
    ViewData["Title"] = "Modificar Pago";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Modificar Pago</h2>

        <p class="text-muted mb-0">
            Modifique los datos del pago seleccionado.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">
                Datos del Pago
            </h5>
        </div>

        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                <input type="hidden"
                       asp-for="ID_pago" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <!-- RESERVA -->
                    <div class="col-md-6">

                        <label asp-for="ID_reserva"
                               class="form-label fw-semibold">
                            Reserva
                        </label>

                        <select asp-for="ID_reserva"
                                class="form-select"
                                id="reservaSelect">

                            <option value="">
                                Seleccione una reserva
                            </option>

                            @foreach (var reserva in ViewBag.Reservas)
                            {
                                if (reserva.Estado)
                                {
                                    <option value="@reserva.ID_reserva"
                                            data-inicio="@reserva.FechaInicio.ToString("yyyy-MM-dd")"
                                            data-fin="@reserva.FechaFin.ToString("yyyy-MM-dd")"
                                            data-precio="@reserva.MontoPorDia">

                                        Reserva #@reserva.ID_reserva -
                                        @reserva.FechaInicio.ToString("dd/MM/yyyy")
                                        al
                                        @reserva.FechaFin.ToString("dd/MM/yyyy")

                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="ID_reserva"
                              class="text-danger">
                        </span>

                    </div>
                                        <!-- CONCEPTO -->
                    <div class="col-md-6">

                        <label asp-for="Concepto"
                               class="form-label fw-semibold">
                            Concepto
                        </label>

                        <input asp-for="Concepto"
                               class="form-control"
                               placeholder="Ingrese el concepto del pago" />

                        <span asp-validation-for="Concepto"
                              class="text-danger">
                        </span>

                    </div>
                    <!-- FECHA DE PAGO -->
                    <div class="col-md-6">

                        <label asp-for="FechaPago"
                               class="form-label fw-semibold">
                            Fecha de pago
                        </label>

                        <input asp-for="FechaPago"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="FechaPago"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- MONTO -->
                    <div class="col-md-6">

                        <label asp-for="Monto"
                               class="form-label fw-semibold">
                            Monto total
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">$</span>

                            <input asp-for="Monto"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   class="form-control"
                                   id="monto"
                                   readonly />

                        </div>

                        <small class="text-muted">
                            El monto se calcula automáticamente según la reserva.
                        </small>

                        <span asp-validation-for="Monto"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Guardar Cambios
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const reservaSelect =
            document.getElementById("reservaSelect");

        const montoInput =
            document.getElementById("monto");

        function calcularMonto() {

            const opcion =
                reservaSelect.options[
                    reservaSelect.selectedIndex
                ];

            const fechaInicio =
                opcion.getAttribute("data-inicio");

            const fechaFin =
                opcion.getAttribute("data-fin");

            const precioPorDia =
                opcion.getAttribute("data-precio");

            if (!fechaInicio ||
                !fechaFin ||
                !precioPorDia) {

                montoInput.value = "";
                return;
            }

            const inicio =
                new Date(fechaInicio);

            const fin =
                new Date(fechaFin);

            const diferenciaMilisegundos =
                fin - inicio;

            const cantidadDias =
                diferenciaMilisegundos /
                (1000 * 60 * 60 * 24);

            const total =
                cantidadDias *
                parseFloat(precioPorDia);

            montoInput.value =
                total.toFixed(2);
        }

        reservaSelect.addEventListener(
            "change",
            calcularMonto
        );

    </script>

}