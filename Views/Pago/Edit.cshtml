@model AnaYAntonio_ProyectoInmobiliaria.Models.Pago

@{
    ViewData["Title"] = "Modificar Pago";
}

<div class="py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">

        <p class="text-uppercase text-secondary fw-semibold mb-2"
           style="letter-spacing: 1.5px;">
            Gestión inmobiliaria
        </p>

        <h1 class="fw-semibold mb-2">
            Modificar pago
        </h1>

        <p class="text-secondary mb-0">
            Modificá el concepto del pago seleccionado.
        </p>

    </div>


    <!-- FORMULARIO -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4 p-lg-5">

            <form asp-action="Edit"
                  method="post"
                  class="row g-4">

                <input type="hidden"
                       asp-for="ID_pago" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-2">
                </div>


                <!-- RESERVA -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Reserva
                    </label>

                    <input type="text"
                           class="form-control"
                           value="Reserva #@Model.ID_reserva"
                           readonly />

                </div>


                <!-- FECHA DE PAGO -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Fecha de pago
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.FechaPago.ToString("dd/MM/yyyy")"
                           readonly />

                </div>


                <!-- MONTO -->
                <div class="col-md-6">

                    <label class="form-label fw-semibold">
                        Monto total
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            $
                        </span>

                        <input type="text"
                               class="form-control"
                               value="@Model.Monto.ToString("N2")"
                               readonly />

                    </div>

                </div>


                <!-- CONCEPTO -->
                <div class="col-md-6">

                    <label asp-for="Concepto"
                           class="form-label fw-semibold">

                        Concepto

                    </label>

                    <input asp-for="Concepto"
                           class="form-control"
                           placeholder="Ingresá el concepto del pago" />

                    <span asp-validation-for="Concepto"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- BOTONES -->
                <div class="col-12">

                    <hr class="my-2">

                    <div class="d-flex flex-column flex-sm-row
                                justify-content-between
                                gap-2
                                align-items-sm-center
                                pt-3">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            ← Volver

                        </a>

                        <button type="submit"
                                class="btn btn-dark px-4">

                            Guardar cambios

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}