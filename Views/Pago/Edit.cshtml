@model AnaYAntonio_ProyectoInmobiliaria.Models.Pago

@{
    ViewData["Title"] = "Modificar Pago";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Modificar Pago</h2>
        <p class="text-muted mb-0">
            Modifique el concepto del pago seleccionado.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">
                Datos del Pago
            </h5>
        </div>

        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="ID_pago" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <!-- RESERVA -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Reserva
                        </label>

                        <input type="text"
                               class="form-control"
                               value="Reserva #@Model.ID_reserva"
                               readonly />
                    </div>

                    <!-- FECHA DE PAGO -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Fecha de pago
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@Model.FechaPago.ToString("dd/MM/yyyy")"
                               readonly />
                    </div>

                    <!-- MONTO -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">
                            Monto total
                        </label>

                        <div class="input-group">
                            <span class="input-group-text">$</span>

                            <input type="text"
                                   class="form-control"
                                   value="@Model.Monto.ToString("N2")"
                                   readonly />
                        </div>
                    </div>

                    <!-- CONCEPTO -->
                    <div class="col-md-6">
                        <label asp-for="Concepto"
                               class="form-label fw-semibold">
                            Concepto
                        </label>

                        <input asp-for="Concepto"
                               class="form-control"
                               placeholder="Ingrese el concepto del pago" />

                        <span asp-validation-for="Concepto"
                              class="text-danger">
                        </span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Guardar Cambios
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}