@model AnaYAntonio_ProyectoInmobiliaria.Models.Pago

@{
    ViewData["Title"] = "Nuevo Pago";
}

<div class="py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">

        <p class="text-uppercase text-secondary fw-semibold mb-2"
           style="letter-spacing: 1.5px;">
            Gestión inmobiliaria
        </p>

        <h1 class="fw-semibold mb-2">
            Nuevo pago
        </h1>

        <p class="text-secondary mb-0">
            Registrá un pago correspondiente a una reserva.
        </p>

    </div>


    <!-- FORMULARIO -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4 p-lg-5">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4">
            </div>


            <form asp-action="Create"
                  method="post"
                  class="row g-4">

                <!-- RESERVA -->
                <div class="col-md-6">

                    <label asp-for="ID_reserva"
                           class="form-label fw-semibold">

                        Reserva

                    </label>

                    <select asp-for="ID_reserva"
                            class="form-select">

                        <option value="">
                            Seleccioná una reserva
                        </option>

                        @foreach (var reserva in ViewBag.Reservas)
                        {
                            if (reserva.Estado)
                            {
                                <option value="@reserva.ID_reserva"
                                        data-inicio="@reserva.FechaInicio.ToString("yyyy-MM-dd")"
                                        data-fin="@reserva.FechaFin.ToString("yyyy-MM-dd")"
                                        data-precio="@reserva.MontoPorDia">

                                    Reserva #@reserva.ID_reserva -
                                    @reserva.FechaInicio.ToString("dd/MM/yyyy")
                                    al
                                    @reserva.FechaFin.ToString("dd/MM/yyyy")

                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="ID_reserva"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- CONCEPTO -->
                <div class="col-md-6">

                    <label asp-for="Concepto"
                           class="form-label fw-semibold">

                        Concepto

                    </label>

                    <input asp-for="Concepto"
                           class="form-control"
                           placeholder="Ingresá el concepto del pago" />

                    <span asp-validation-for="Concepto"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- FECHA DE PAGO -->
                <div class="col-md-6">

                    <label asp-for="FechaPago"
                           class="form-label fw-semibold">

                        Fecha de pago

                    </label>

                    <input asp-for="FechaPago"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="FechaPago"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- MONTO -->
                <div class="col-md-6">

                    <label asp-for="Monto"
                           class="form-label fw-semibold">

                        Monto

                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            $
                        </span>

                        <input asp-for="Monto"
                               type="number"
                               min="0.01"
                               step="0.01"
                               class="form-control"
                               id="monto"
                               readonly />

                    </div>

                    <span asp-validation-for="Monto"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- BOTONES -->
                <div class="col-12">

                    <hr class="my-2">

                    <div class="d-flex flex-column flex-sm-row
                                justify-content-between
                                gap-2
                                align-items-sm-center
                                pt-3">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            ← Volver

                        </a>

                        <button type="submit"
                                class="btn btn-dark px-4">

                            Guardar pago

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const reservaSelect =
            document.getElementById("ID_reserva");

        const montoInput =
            document.getElementById("monto");


        function calcularMonto() {

            const opcion =
                reservaSelect.options[
                    reservaSelect.selectedIndex
                ];


            const fechaInicio =
                opcion.getAttribute("data-inicio");

            const fechaFin =
                opcion.getAttribute("data-fin");

            const precioPorDia =
                opcion.getAttribute("data-precio");


            if (!fechaInicio ||
                !fechaFin ||
                !precioPorDia) {

                montoInput.value = "";

                return;
            }


            const inicio =
                new Date(fechaInicio);

            const fin =
                new Date(fechaFin);


            const diferenciaMilisegundos =
                fin - inicio;


            const cantidadDias =
                diferenciaMilisegundos /
                (1000 * 60 * 60 * 24);


            const total =
                cantidadDias *
                parseFloat(precioPorDia);


            montoInput.value =
                total.toFixed(2);

        }


        reservaSelect.addEventListener(
            "change",
            calcularMonto
        );

    </script>

}