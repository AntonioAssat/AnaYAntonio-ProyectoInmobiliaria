@model AnaYAntonio_ProyectoInmobiliaria.Models.Inmueble

@{
    ViewData["Title"] = "Editar Inmueble";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-10 col-lg-8 col-xl-7">

            <div class="card border-0 shadow rounded-4 overflow-hidden">

                <div class="card-header bg-primary text-white border-0 p-4">
                    <div>
                        <h1 class="h3 mb-1">Editar inmueble</h1>

                        <p class="mb-0 text-white-50">
                            Modificá los datos del inmueble.
                        </p>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <form asp-action="Edit"
                          method="post"
                          class="row g-3">

                        <input type="hidden"
                               asp-for="ID_inmueble" />


                        <!-- PROPIETARIO -->

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Propietario
                            </label>

                            <div class="input-group">

                                <select name="DuenioId"
                                        class="form-select">

                                    <option value="">
                                        Seleccioná un propietario
                                    </option>

                                    @foreach (var propietario in ViewBag.Propietarios)
                                    {
                                        if (Model.Duenio != null &&
                                            propietario.ID_propietario == Model.Duenio.ID_propietario)
                                        {
                                            <option value="@propietario.ID_propietario"
                                                    selected>
                                                @propietario.Nombre @propietario.Apellido
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@propietario.ID_propietario">
                                                @propietario.Nombre @propietario.Apellido
                                            </option>
                                        }
                                    }

                                </select>

                                <a asp-controller="Propietarios"
                                   asp-action="Create"
                                   asp-route-returnUrl="/Inmuebles/Edit/@Model.ID_inmueble"
                                   class="btn btn-outline-primary">
                                    + Nuevo propietario
                                </a>

                            </div>

                        </div>


                        <!-- TIPO DE INMUEBLE -->

                        <div class="col-12">

                            <label class="form-label fw-semibold">
                                Tipo de inmueble
                            </label>

                            <div class="input-group">

                                <select name="TipoId"
                                        class="form-select">

                                    <option value="">
                                        Seleccioná un tipo
                                    </option>

                                    @foreach (var tipo in ViewBag.Tipos)
                                    {
                                        if (Model.Tipo != null &&
                                            tipo.ID_tipo == Model.Tipo.ID_tipo)
                                        {
                                            <option value="@tipo.ID_tipo"
                                                    selected>
                                                @tipo.Nombre
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="@tipo.ID_tipo">
                                                @tipo.Nombre
                                            </option>
                                        }
                                    }

                                </select>

                                <a asp-controller="TipoInmuebles"
                                   asp-action="Create"
                                   asp-route-returnUrl="/Inmuebles/Edit/@Model.ID_inmueble"
                                   class="btn btn-outline-primary">
                                    + Nuevo tipo
                                </a>

                            </div>

                        </div>


                        <!-- DIRECCIÓN -->

                        <div class="col-12">

                            <label asp-for="Direccion"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Direccion"
                                   class="form-control" />

                            <span asp-validation-for="Direccion"
                                  class="text-danger small d-block mt-1">
                            </span>

                        </div>


                        <!-- CUPO -->

                        <div class="col-md-6">

                            <label asp-for="Cupo"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Cupo"
                                   type="number"
                                   min="1"
                                   class="form-control" />

                            <span asp-validation-for="Cupo"
                                  class="text-danger small d-block mt-1">
                            </span>

                        </div>


                        <!-- COORDENADAS -->

                        <div class="col-md-6">

                            <label asp-for="Coordenadas"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Coordenadas"
                                   type="number"
                                   step="any"
                                   class="form-control" />

                            <span asp-validation-for="Coordenadas"
                                  class="text-danger small d-block mt-1">
                            </span>

                        </div>


                        <!-- PRECIO POR DÍA -->

                        <div class="col-md-6">

                            <label asp-for="PrecioPorDia"
                                   class="form-label fw-semibold">
                                Precio por día
                            </label>

                            <input asp-for="PrecioPorDia"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />

                            <span asp-validation-for="PrecioPorDia"
                                  class="text-danger small d-block mt-1">
                            </span>

                        </div>


                        <!-- PORCENTAJE DE RESERVA -->

                        <div class="col-md-6">

                            <label asp-for="PorcentajeReserva"
                                   class="form-label fw-semibold">
                                Porcentaje de reserva
                            </label>

                            <div class="input-group">

                                <input asp-for="PorcentajeReserva"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       max="100"
                                       class="form-control" />

                                <span class="input-group-text">
                                    %
                                </span>

                            </div>

                            <span asp-validation-for="PorcentajeReserva"
                                  class="text-danger small d-block mt-1">
                            </span>

                        </div>


                        <!-- BOTONES -->

                        <div class="col-12 d-flex flex-column flex-sm-row justify-content-between gap-2 align-items-sm-center mt-4 pt-3 border-top">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                ← Volver
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Guardar cambios
                            </button>

                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}