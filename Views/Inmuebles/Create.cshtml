@model AnaYAntonio_ProyectoInmobiliaria.Models.Inmueble

@{
    ViewData["Title"] = "Nuevo Inmueble";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-10 col-lg-8 col-xl-7">

            <div class="card border-0 shadow rounded-4 overflow-hidden">

                <div class="card-header bg-primary text-white border-0 p-4">
                    <div>
                        <h1 class="h3 mb-1">Nuevo inmueble</h1>

                        <p class="mb-0 text-white-50">
                            Completá los datos para registrar un inmueble.
                        </p>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <form asp-action="Create"
                          method="post"
                          class="row g-3">

                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Propietario
                            </label>

                            <select name="Duenio.ID_propietario"
                                    class="form-select">

                                <option value="">
                                    Seleccioná un propietario
                                </option>

                                @foreach (var propietario in ViewBag.Propietarios)
                                {
                                    <option value="@propietario.ID_propietario">
                                        @propietario.Nombre @propietario.Apellido
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-semibold">
                                Tipo de inmueble
                            </label>

                            <select name="Tipo.ID_tipo"
                                    class="form-select">

                                <option value="">
                                    Seleccioná un tipo
                                </option>

                                @foreach (var tipo in ViewBag.Tipos)
                                {
                                    <option value="@tipo.ID_tipo">
                                        @tipo.Nombre
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="col-12">
                            <label asp-for="Direccion"
                                   class="form-label fw-semibold"></label>

                            <input asp-for="Direccion"
                                   class="form-control"
                                   placeholder="Ingresá la dirección" />

                            <span asp-validation-for="Direccion"
                                  class="text-danger small d-block mt-1"></span>
                        </div>

                        <div class="col-md-6">

                            <label asp-for="Cupo"
                                   class="form-label fw-semibold"></label>

                            <input asp-for="Cupo"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   placeholder="Cantidad de personas" />

                            <span asp-validation-for="Cupo"
                                  class="text-danger small d-block mt-1"></span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="Coordenadas"
                                   class="form-label fw-semibold"></label>

                            <input asp-for="Coordenadas"
                                   type="number"
                                   step="any"
                                   class="form-control"
                                   placeholder="Coordenadas" />

                            <span asp-validation-for="Coordenadas"
                                  class="text-danger small d-block mt-1"></span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="PrecioPorDia"
                                   class="form-label fw-semibold">
                                Precio por día
                            </label>

                            <input asp-for="PrecioPorDia"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   placeholder="0,00" />

                            <span asp-validation-for="PrecioPorDia"
                                  class="text-danger small d-block mt-1"></span>

                        </div>

                        <div class="col-md-6">

                            <label asp-for="PorcentajeReserva"
                                   class="form-label fw-semibold">
                                Porcentaje de reserva
                            </label>

                            <div class="input-group">
                                <input asp-for="PorcentajeReserva"
                                       type="number"
                                       step="0.01"
                                       min="0"
                                       max="100"
                                       class="form-control"
                                       placeholder="0,00" />

                                <span class="input-group-text">%</span>
                            </div>

                            <span asp-validation-for="PorcentajeReserva"
                                  class="text-danger small d-block mt-1"></span>

                        </div>

                        <div class="col-12 d-flex flex-column flex-sm-row justify-content-between gap-2 align-items-sm-center mt-4 pt-3 border-top">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                ← Volver
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Cargar inmueble
                            </button>

                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}