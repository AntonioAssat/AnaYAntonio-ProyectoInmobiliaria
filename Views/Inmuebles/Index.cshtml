@model IList<AnaYAntonio_ProyectoInmobiliaria.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";
}

<div class="container py-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Inmuebles</h1>
            <p class="text-muted mb-0">
                Administración de los inmuebles de la inmobiliaria.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Nuevo inmueble
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <div class="card border-0 shadow rounded-4 overflow-hidden">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Dirección</th>
                            <th>Propietario</th>
                            <th>Tipo</th>
                            <th>Cupo</th>
                            <th>Precio por día</th>
                            <th>Reserva</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Count > 0)
                        {
                            foreach (var inmueble in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">
                                            @inmueble.Direccion
                                        </span>
                                    </td>

                                    <td>
                                        @inmueble.Duenio.Nombre @inmueble.Duenio.Apellido
                                    </td>

                                    <td>
                                        @inmueble.Tipo.Nombre
                                    </td>

                                    <td>
                                        @inmueble.Cupo personas
                                    </td>

                                    <td>
                                        $ @inmueble.PrecioPorDia.ToString("N2")
                                    </td>

                                    <td>
                                        @inmueble.PorcentajeReserva.ToString("N2")%
                                    </td>

                                    <td>
                                        @if (inmueble.Estado)
                                        {
                                            <span class="badge text-bg-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <a asp-action="Edit"
                                           asp-route-id="@inmueble.ID_inmueble"
                                           class="btn btn-outline-primary btn-sm">
                                            Editar
                                        </a>

                                        @if (inmueble.Estado)
                                        {
                                            <form asp-action="Baja"
                                                  asp-route-id="@inmueble.ID_inmueble"
                                                  method="post"
                                                  class="d-inline">

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm ms-1">
                                                    Dar de baja
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="AltaEstado"
                                                  asp-route-id="@inmueble.ID_inmueble"
                                                  method="post"
                                                  class="d-inline">

                                                <button type="submit"
                                                        class="btn btn-outline-success btn-sm ms-1">
                                                    Dar de alta
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    No hay inmuebles registrados.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
</div>