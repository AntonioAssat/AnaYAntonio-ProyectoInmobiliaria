@model IList<AnaYAntonio_ProyectoInmobiliaria.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";
}

<div id="app" class="container py-5">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">

        <div>
            <h1 class="h2 mb-1">
                Inmuebles
            </h1>

            <p class="text-muted mb-0">
                Administración de los inmuebles de la inmobiliaria.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Nuevo inmueble
        </a>

    </div>


    <!-- MENSAJE -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">

            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }


    <!-- CARDS -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="row g-4">

            @foreach (var inmueble in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">

                    <div class="card h-100 border-0 shadow rounded-4 overflow-hidden">

                        <!-- IMAGEN -->
                        @if (inmueble.Imagenes != null &&
                            inmueble.Imagenes.Count > 0)
                        {
                            <img src="@inmueble.Imagenes[0].Url"
                                 alt="Imagen de @inmueble.Direccion"
                                 class="card-img-top"
                                 style="height: 230px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height: 230px;">

                                <div class="text-center text-muted">

                                    <div class="fs-1 mb-2">
                                        🏠
                                    </div>

                                    <div>
                                        Sin imágenes
                                    </div>

                                </div>

                            </div>
                        }


                        <!-- CONTENIDO -->
                        <div class="card-body p-4">

                            <!-- DIRECCIÓN + ESTADO -->
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">

                                <div>

                                    <h2 class="h5 mb-1">
                                        @inmueble.Direccion
                                    </h2>

                                    <span class="text-muted small">
                                        @inmueble.Tipo.Nombre
                                    </span>

                                </div>

                                @if (inmueble.Estado)
                                {
                                    <span class="badge text-bg-success">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">
                                        Inactivo
                                    </span>
                                }

                            </div>


                            <!-- PROPIETARIO -->
                            <div class="mb-3">

                                <div class="small text-muted">
                                    Propietario
                                </div>

                                <div class="fw-semibold">
                                    @inmueble.Duenio.Nombre
                                    @inmueble.Duenio.Apellido
                                </div>

                            </div>


                            <!-- DATOS -->
                            <div class="row g-3 mb-3">

                                <div class="col-6">

                                    <div class="small text-muted">
                                        Capacidad
                                    </div>

                                    <div class="fw-semibold">
                                        @inmueble.Cupo personas
                                    </div>

                                </div>


                                <div class="col-6">

                                    <div class="small text-muted">
                                        Reserva
                                    </div>

                                    <div class="fw-semibold">
                                        @inmueble.PorcentajeReserva.ToString("N2")%
                                    </div>

                                </div>

                            </div>


                            <!-- PRECIO -->
                            <div class="border-top pt-3">

                                <div class="small text-muted">
                                    Precio por día
                                </div>

                                <div class="fs-4 fw-bold">
                                    $ @inmueble.PrecioPorDia.ToString("N2")
                                </div>

                            </div>

                        </div>


                        <!-- ACCIONES -->
                        <div class="card-footer bg-white border-0 px-4 pb-4">

                            <!-- VER DETALLE -->
                            <a asp-action="Details"
                               asp-route-id="@inmueble.ID_inmueble"
                               class="btn btn-primary w-100 mb-2">

                                Ver detalle

                            </a>


                            <div class="d-flex gap-2">

                                <!-- EDITAR -->
                                <a asp-action="Edit"
                                   asp-route-id="@inmueble.ID_inmueble"
                                   class="btn btn-outline-primary btn-sm flex-grow-1">

                                    Editar

                                </a>


                                <!-- BAJA / ALTA -->
                                @if (inmueble.Estado)
                                {
                                    <form v-if="esAdministrador"
                                          asp-action="Baja"
                                          asp-route-id="@inmueble.ID_inmueble"
                                          method="post"
                                          class="flex-grow-1">

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm w-100">

                                            Dar de baja

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <form v-if="esAdministrador"
                                          asp-action="AltaEstado"
                                          asp-route-id="@inmueble.ID_inmueble"
                                          method="post"
                                          class="flex-grow-1">

                                        <button type="submit"
                                                class="btn btn-outline-success btn-sm w-100">

                                            Dar de alta

                                        </button>

                                    </form>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- SIN INMUEBLES -->
        <div class="card border-0 shadow rounded-4">

            <div class="card-body text-center py-5">

                <div class="fs-1 mb-3">
                    🏠
                </div>

                <h2 class="h5">
                    No hay inmuebles registrados
                </h2>

                <p class="text-muted mb-4">
                    Todavía no se registraron inmuebles en el sistema.
                </p>

                <a asp-action="Create" class="btn btn-primary">
                    + Nuevo inmueble
                </a>

            </div>

        </div>
    }

</div>


<!-- VUE 3 -->
<script src="https://unpkg.com/vue@3"></script>

<script>
    Vue.createApp({

        data() {
            return {
                esAdministrador: @(User.IsInRole("Administrador").ToString().ToLower())
            };
        }

    }).mount('#app');
</script>