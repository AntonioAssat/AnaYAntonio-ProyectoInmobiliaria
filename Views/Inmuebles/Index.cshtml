@model IList<AnaYAntonio_ProyectoInmobiliaria.Models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int cantidadPaginas = ViewBag.CantidadPaginas ?? 0;
    int cantidadTotal = ViewBag.CantidadTotal ?? 0;
    string buscar = ViewBag.Buscar ?? "";
}

<div id="app" class="py-4">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3
                mb-4">

        <div>

            <p class="text-uppercase text-secondary fw-semibold mb-2"
               style="letter-spacing: 1.5px;">
                Gestión inmobiliaria
            </p>

            <h1 class="fw-semibold mb-2">
                Inmuebles
            </h1>

            <p class="text-secondary mb-0">
                Administración de los inmuebles de la inmobiliaria.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-dark">

            + Nuevo inmueble

        </a>

    </div>


    <!-- MENSAJE -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4"
             role="alert">

            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }


    <!-- BUSCADOR -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-4">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-12 col-md-9">

                    <label for="buscar"
                           class="form-label fw-semibold">

                        Buscar inmueble

                    </label>

                    <input type="text"
                           id="buscar"
                           name="buscar"
                           value="@buscar"
                           class="form-control"
                           placeholder="Dirección, propietario o tipo de inmueble..." />

                </div>

                <div class="col-12 col-md-3 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-dark flex-grow-1">

                        Buscar

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Limpiar

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- CANTIDAD DE RESULTADOS -->
    @if (cantidadTotal > 0)
    {
        <div class="text-secondary mb-3">

            Se encontraron
            <strong>@cantidadTotal</strong>
            inmueble(s).

        </div>
    }


    <!-- CARDS -->
    @if (Model != null && Model.Count > 0)
    {
        <div class="row g-4">

            @foreach (var inmueble in Model)
            {
                <div class="col-12 col-md-6 col-xl-4">

                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                        <!-- IMAGEN -->
                        @if (inmueble.Imagenes != null &&
                             inmueble.Imagenes.Count > 0)
                        {
                            <img src="@inmueble.Imagenes[0].Url"
                                 alt="Imagen de @inmueble.Direccion"
                                 class="card-img-top"
                                 style="height: 230px;
                                        object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex
                                        align-items-center
                                        justify-content-center"
                                 style="height: 230px;">

                                <div class="text-center text-secondary">

                                    <div class="fs-1 mb-2">
                                        🏠
                                    </div>

                                    <div>
                                        Sin imágenes
                                    </div>

                                </div>

                            </div>
                        }


                        <!-- CONTENIDO -->
                        <div class="card-body p-4">

                            <!-- DIRECCIÓN + ESTADO -->
                            <div class="d-flex
                                        justify-content-between
                                        align-items-start
                                        gap-2
                                        mb-3">

                                <div>

                                    <h2 class="h5 mb-1">
                                        @inmueble.Direccion
                                    </h2>

                                    <span class="text-secondary small">
                                        @inmueble.Tipo.Nombre
                                    </span>

                                </div>

                                @if (inmueble.Estado)
                                {
                                    <span class="badge text-bg-success">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">
                                        Inactivo
                                    </span>
                                }

                            </div>


                            <!-- PROPIETARIO -->
                            <div class="mb-3">

                                <div class="small text-secondary">
                                    Propietario
                                </div>

                                <div class="fw-semibold">

                                    @inmueble.Duenio.Nombre
                                    @inmueble.Duenio.Apellido

                                </div>

                            </div>


                            <!-- DATOS -->
                            <div class="row g-3 mb-3">

                                <div class="col-6">

                                    <div class="small text-secondary">
                                        Capacidad
                                    </div>

                                    <div class="fw-semibold">
                                        @inmueble.Cupo personas
                                    </div>

                                </div>

                                <div class="col-6">

                                    <div class="small text-secondary">
                                        Reserva
                                    </div>

                                    <div class="fw-semibold">
                                        @inmueble.PorcentajeReserva.ToString("N2")%
                                    </div>

                                </div>

                            </div>


                            <!-- PRECIO -->
                            <div class="border-top pt-3">

                                <div class="small text-secondary">
                                    Precio por día
                                </div>

                                <div class="fs-4 fw-bold">
                                    $ @inmueble.PrecioPorDia.ToString("N2")
                                </div>

                            </div>

                        </div>


                        <!-- ACCIONES -->
                        <div class="card-footer bg-white border-0 px-4 pb-4">

                            <!-- VER DETALLE -->
                            <a asp-action="Details"
                               asp-route-id="@inmueble.ID_inmueble"
                               class="btn btn-dark w-100 mb-2">

                                Ver detalle

                            </a>


                            <div class="d-flex gap-2">

                                <!-- EDITAR -->
                                <a asp-action="Edit"
                                   asp-route-id="@inmueble.ID_inmueble"
                                   class="btn btn-outline-secondary btn-sm flex-grow-1">

                                    Editar

                                </a>


                                <!-- BAJA / ALTA -->
                                @if (inmueble.Estado)
                                {
                                    <form v-if="esAdministrador"
                                          asp-action="Baja"
                                          asp-route-id="@inmueble.ID_inmueble"
                                          method="post"
                                          class="flex-grow-1">

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm w-100">

                                            Dar de baja

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <form v-if="esAdministrador"
                                          asp-action="AltaEstado"
                                          asp-route-id="@inmueble.ID_inmueble"
                                          method="post"
                                          class="flex-grow-1">

                                        <button type="submit"
                                                class="btn btn-outline-success btn-sm w-100">

                                            Dar de alta

                                        </button>

                                    </form>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- SIN RESULTADOS -->
        <div class="card border-0 shadow-sm rounded-4">

            <div class="card-body text-center py-5">

                <div class="fs-1 mb-3">
                    🏠
                </div>

                @if (!string.IsNullOrWhiteSpace(buscar))
                {
                    <h2 class="h5">
                        No se encontraron inmuebles
                    </h2>

                    <p class="text-secondary mb-4">

                        No hay inmuebles que coincidan con
                        "<strong>@buscar</strong>".

                    </p>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Limpiar búsqueda

                    </a>
                }
                else
                {
                    <h2 class="h5">
                        No hay inmuebles registrados
                    </h2>

                    <p class="text-secondary mb-4">

                        Todavía no se registraron inmuebles en el sistema.

                    </p>

                    <a asp-action="Create"
                       class="btn btn-dark">

                        + Nuevo inmueble

                    </a>
                }

            </div>

        </div>
    }


    <!-- PAGINACIÓN -->
    @if (cantidadPaginas > 1)
    {
        <nav aria-label="Paginación de inmuebles"
             class="mt-5">

            <ul class="pagination justify-content-center">

                <!-- ANTERIOR -->
                <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">

                    @if (paginaActual > 1)
                    {
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-buscar="@buscar"
                           asp-route-pagina="@(paginaActual - 1)">

                            ← Anterior

                        </a>
                    }
                    else
                    {
                        <span class="page-link">
                            ← Anterior
                        </span>
                    }

                </li>


                <!-- NÚMEROS -->
                @for (int i = 1; i <= cantidadPaginas; i++)
                {
                    <li class="page-item @(i == paginaActual ? "active" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-buscar="@buscar"
                           asp-route-pagina="@i">

                            @i

                        </a>

                    </li>
                }


                <!-- SIGUIENTE -->
                <li class="page-item @(paginaActual >= cantidadPaginas ? "disabled" : "")">

                    @if (paginaActual < cantidadPaginas)
                    {
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-buscar="@buscar"
                           asp-route-pagina="@(paginaActual + 1)">

                            Siguiente →

                        </a>
                    }
                    else
                    {
                        <span class="page-link">
                            Siguiente →
                        </span>
                    }

                </li>

            </ul>

        </nav>
    }

</div>


<!-- VUE 3 -->
<script src="https://unpkg.com/vue@3"></script>

<script>

    Vue.createApp({

        data() {

            return {

                esAdministrador:
                    @(User.IsInRole("Administrador").ToString().ToLower())

            };

        }

    }).mount('#app');

</script>