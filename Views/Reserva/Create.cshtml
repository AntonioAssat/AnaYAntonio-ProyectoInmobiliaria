@model AnaYAntonio_ProyectoInmobiliaria.Models.Reserva

@{
    ViewData["Title"] = "Nueva Reserva";
}

<div class="py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">

        <p class="text-uppercase text-secondary fw-semibold mb-2"
           style="letter-spacing: 1.5px;">
            Gestión inmobiliaria
        </p>

        <h1 class="fw-semibold mb-2">
            Nueva reserva
        </h1>

        <p class="text-secondary mb-0">
            Registrá una nueva reserva de un inmueble.
        </p>

    </div>


    <!-- FORMULARIO -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4 p-lg-5">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4">
            </div>


            <form asp-action="Create"
                  method="post"
                  class="row g-4">

                <!-- INQUILINO -->
                <div class="col-md-6">

                    <label asp-for="ID_inquilino"
                           class="form-label fw-semibold">

                        Inquilino

                    </label>

                    <select asp-for="ID_inquilino"
                            class="form-select">

                        <option value="">
                            Seleccioná un inquilino
                        </option>

                        @foreach (var inquilino in ViewBag.Inquilinos)
                        {
                            if (inquilino.Estado)
                            {
                                <option value="@inquilino.ID_inquilino">

                                    @inquilino.Nombre
                                    @inquilino.Apellido
                                    - DNI: @inquilino.DNI

                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="ID_inquilino"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- INMUEBLE -->
                <div class="col-md-6">

                    <label asp-for="ID_inmueble"
                           class="form-label fw-semibold">

                        Inmueble

                    </label>

                    <select asp-for="ID_inmueble"
                            class="form-select"
                            id="inmuebleSelect">

                        <option value="">
                            Seleccioná un inmueble
                        </option>

                        @foreach (var inmueble in ViewBag.Inmuebles)
                        {
                            if (inmueble.Estado)
                            {
                                <option value="@inmueble.ID_inmueble"
                                        data-precio="@inmueble.PrecioPorDia">

                                    @inmueble.Direccion

                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="ID_inmueble"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- FECHA INICIO -->
                <div class="col-md-6">

                    <label asp-for="FechaInicio"
                           class="form-label fw-semibold">

                        Fecha de inicio

                    </label>

                    <input asp-for="FechaInicio"
                           class="form-control"
                           type="date" />

                    <span asp-validation-for="FechaInicio"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- FECHA FIN -->
                <div class="col-md-6">

                    <label asp-for="FechaFin"
                           class="form-label fw-semibold">

                        Fecha de finalización

                    </label>

                    <input asp-for="FechaFin"
                           class="form-control"
                           type="date" />

                    <span asp-validation-for="FechaFin"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- MONTO POR DÍA -->
                <div class="col-md-6">

                    <label asp-for="MontoPorDia"
                           class="form-label fw-semibold">

                        Monto por día

                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            $
                        </span>

                        <input asp-for="MontoPorDia"
                               class="form-control"
                               type="number"
                               min="0.01"
                               step="0.01"
                               id="montoPorDia"
                               readonly />

                    </div>

                    <small class="text-secondary">
                        Se completa automáticamente según el inmueble seleccionado.
                    </small>

                    <span asp-validation-for="MontoPorDia"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- BOTONES -->
                <div class="col-12">

                    <hr class="my-2">

                    <div class="d-flex flex-column flex-sm-row
                                justify-content-between
                                gap-2
                                align-items-sm-center
                                pt-3">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            ← Volver

                        </a>

                        <button type="submit"
                                class="btn btn-dark px-4">

                            Guardar reserva

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const inmuebleSelect =
            document.getElementById("inmuebleSelect");

        const montoPorDia =
            document.getElementById("montoPorDia");


        function actualizarMonto() {

            const opcionSeleccionada =
                inmuebleSelect.options[
                    inmuebleSelect.selectedIndex
                ];


            let precio =
                opcionSeleccionada.getAttribute("data-precio");


            if (precio) {

                // Convertimos la coma decimal en punto
                precio = precio.replace(",", ".");

                montoPorDia.value = precio;

            }
            else {

                montoPorDia.value = "";

            }

        }


        inmuebleSelect.addEventListener(
            "change",
            actualizarMonto
        );


        actualizarMonto();

    </script>

}