@model AnaYAntonio_ProyectoInmobiliaria.Models.Reserva

@{
    ViewData["Title"] = "Finalizar Reserva Anticipadamente";
}

<div class="py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Gestión inmobiliaria</h2>
        <p class="text-muted mb-0">
            Finalizar reserva anticipadamente
        </p>
    </div>

    <!-- CONTENIDO -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

            <h5 class="fw-semibold mb-4">
                Datos de la reserva
            </h5>

            <!-- DATOS ORIGINALES -->
            <div class="row g-4">

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Fecha de inicio
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.FechaInicio.ToString("dd/MM/yyyy")"
                           readonly />

                </div>

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Fecha de finalización original
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.FechaFin.ToString("dd/MM/yyyy")"
                           readonly />

                </div>

                <div class="col-md-4">

                    <label class="form-label fw-semibold">
                        Monto por día
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">$</span>

                        <input type="text"
                               class="form-control"
                               value="@Model.MontoPorDia.ToString("N2")"
                               readonly />

                    </div>

                </div>

            </div>

            <hr class="my-4" />

            <form id="formFinalizar"
                  asp-action="FinalizarAnticipadamente"
                  method="post">

                <input type="hidden"
                       name="id"
                       value="@Model.ID_reserva" />

                <!-- FECHA EFECTIVA -->
                <div class="row g-4">

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Fecha efectiva de finalización
                        </label>

                        <input type="date"
                               name="fechaFinEfectiva"
                               id="fechaFinEfectiva"
                               class="form-control"
                               min="@Model.FechaInicio.ToString("yyyy-MM-dd")"
                               max="@Model.FechaFin.ToString("yyyy-MM-dd")"
                               required />

                        <div class="form-text">
                            Seleccione la fecha en la que finaliza efectivamente la reserva.
                        </div>

                    </div>

                </div>

                <hr class="my-4" />

                <!-- RESULTADO DE LA MULTA -->
                <div id="resultadoMulta"
                     class="alert alert-warning rounded-3"
                     style="display: none;">

                    <h5 class="fw-semibold mb-3">
                        Cálculo de la multa
                    </h5>

                    <p class="mb-1">
                        <strong>Días restantes:</strong>
                        <span id="diasRestantes"></span>
                    </p>

                    <p class="mb-1">
                        <strong>Porcentaje de multa:</strong>
                        <span id="porcentajeMulta"></span>
                    </p>

                    <p class="mb-3">
                        <strong>Multa a pagar:</strong>
                        $<span id="montoMulta"></span>
                    </p>

                    <div class="form-check">

                        <input class="form-check-input"
                               type="checkbox"
                               id="multaPagada"
                               name="multaPagada"
                               value="true" />

                        <label class="form-check-label fw-semibold"
                               for="multaPagada">

                            Confirmo que el inquilino pagó la multa
                            en este momento.

                        </label>

                    </div>

                </div>

                <!-- BOTONES -->
                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-danger px-4"
                            id="btnFinalizar"
                            disabled>
                        Finalizar reserva
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {

    <script>

        const fechaInicio =
            new Date("@Model.FechaInicio.ToString("yyyy-MM-dd")");

        const fechaFin =
            new Date("@Model.FechaFin.ToString("yyyy-MM-dd")");

        const montoPorDia =
            parseFloat(
                "@Model.MontoPorDia.ToString(System.Globalization.CultureInfo.InvariantCulture)"
            );

        const fechaFinInput =
            document.getElementById("fechaFinEfectiva");

        const resultadoMulta =
            document.getElementById("resultadoMulta");

        const multaPagada =
            document.getElementById("multaPagada");

        const btnFinalizar =
            document.getElementById("btnFinalizar");


        fechaFinInput.addEventListener("change", function () {

            const fechaEfectiva =
                new Date(this.value);

            if (!this.value) {

                resultadoMulta.style.display = "none";

                multaPagada.checked = false;

                btnFinalizar.disabled = true;

                return;
            }


            const totalDias =
                (fechaFin - fechaInicio) /
                (1000 * 60 * 60 * 24);

            const diasCumplidos =
                (fechaEfectiva - fechaInicio) /
                (1000 * 60 * 60 * 24);

            const diasRestantes =
                (fechaFin - fechaEfectiva) /
                (1000 * 60 * 60 * 24);


            let porcentaje;

            if (diasCumplidos < totalDias / 2) {
                porcentaje = 50;
            }
            else {
                porcentaje = 25;
            }


            const importeRestante =
                diasRestantes * montoPorDia;

            const multa =
                importeRestante * porcentaje / 100;


            document.getElementById("diasRestantes")
                .textContent = diasRestantes;

            document.getElementById("porcentajeMulta")
                .textContent = porcentaje + "%";

            document.getElementById("montoMulta")
                .textContent =
                    multa.toLocaleString(
                        "es-AR",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }
                    );


            resultadoMulta.style.display = "block";


            // Cada vez que cambia la fecha,
            // obligamos a confirmar nuevamente el pago.

            multaPagada.checked = false;

            btnFinalizar.disabled = true;

        });


        multaPagada.addEventListener("change", function () {

            btnFinalizar.disabled = !this.checked;

        });

    </script>

}