@model AnaYAntonio_ProyectoInmobiliaria.Models.Reserva

@{
    ViewData["Title"] = "Renovar Reserva";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-header bg-white">
                    <h3 class="mb-0">
                        Renovar Reserva
                    </h3>
                </div>

                <div class="card-body">

                    <div class="alert alert-info">
                        <strong>Reserva original:</strong>
                        #@Model.ID_reserva
                        <br />
                        La reserva original no será modificada.
                        Se creará una nueva reserva.
                    </div>

                    <form asp-action="Renovar" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="ID_reserva" />

                        <input type="hidden"
                               asp-for="ID_inquilino" />

                        <input type="hidden"
                               asp-for="ID_inmueble" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- INQUILINO -->

                        <div class="mb-3">

                            <label class="form-label">
                                Inquilino
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@ViewBag.InquilinoNombre"
                                   readonly />

                        </div>

                        <!-- INMUEBLE -->

                        <div class="mb-3">

                            <label class="form-label">
                                Inmueble
                            </label>

                            <input type="text"
                                   class="form-control"
                                   value="@ViewBag.InmuebleDireccion"
                                   readonly />

                        </div>

                        <hr />

                        <h5 class="mb-3">
                            Nuevas fechas y monto
                        </h5>

                        <!-- FECHA INICIO -->

                        <div class="mb-3">

                            <label asp-for="FechaInicio"
                                   class="form-label">
                                Nueva fecha de inicio
                            </label>

                            <input asp-for="FechaInicio"
                                   type="datetime-local"
                                   class="form-control" />

                            <span asp-validation-for="FechaInicio"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- FECHA FIN -->

                        <div class="mb-3">

                            <label asp-for="FechaFin"
                                   class="form-label">
                                Nueva fecha de finalización
                            </label>

                            <input asp-for="FechaFin"
                                   type="datetime-local"
                                   class="form-control" />

                            <span asp-validation-for="FechaFin"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- MONTO -->

                        <div class="mb-3">

                            <label asp-for="MontoPorDia"
                                   class="form-label">
                                Nuevo monto por día
                            </label>

                            <input asp-for="MontoPorDia"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   class="form-control" />

                            <span asp-validation-for="MontoPorDia"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-flex justify-content-between mt-4">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Volver
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Renovar reserva
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}