@model AnaYAntonio_ProyectoInmobiliaria.Models.Reserva

@{
    ViewData["Title"] = "Renovar Reserva";
}

<div class="py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Gestión inmobiliaria</h2>
        <p class="text-muted mb-0">
            Renovar reserva
        </p>
    </div>

    <!-- FORMULARIO -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4 p-md-5">

            <h5 class="fw-semibold mb-4">
                Datos de la renovación
            </h5>

            <!-- AVISO -->
            <div class="alert alert-info rounded-3 mb-4">

                <strong>Reserva original:</strong>
                #@Model.ID_reserva

                <br />

                La reserva original no será modificada.
                Se creará una nueva reserva.

            </div>

            <form asp-action="Renovar" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="ID_reserva" />

                <input type="hidden"
                       asp-for="ID_inquilino" />

                <input type="hidden"
                       asp-for="ID_inmueble" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-4">

                    <!-- INQUILINO -->
                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Inquilino
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@ViewBag.InquilinoNombre"
                               readonly />

                    </div>

                    <!-- INMUEBLE -->
                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Inmueble
                        </label>

                        <input type="text"
                               class="form-control"
                               value="@ViewBag.InmuebleDireccion"
                               readonly />

                    </div>

                </div>

                <hr class="my-4" />

                <h5 class="fw-semibold mb-4">
                    Nuevas fechas y monto
                </h5>

                <div class="row g-4">

                    <!-- FECHA INICIO -->
                    <div class="col-md-6">

                        <label asp-for="FechaInicio"
                               class="form-label fw-semibold">
                            Nueva fecha de inicio
                        </label>

                        <input asp-for="FechaInicio"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="FechaInicio"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- FECHA FIN -->
                    <div class="col-md-6">

                        <label asp-for="FechaFin"
                               class="form-label fw-semibold">
                            Nueva fecha de finalización
                        </label>

                        <input asp-for="FechaFin"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="FechaFin"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- MONTO -->
                    <div class="col-md-6">

                        <label asp-for="MontoPorDia"
                               class="form-label fw-semibold">
                            Nuevo monto por día
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">$</span>

                            <input asp-for="MontoPorDia"
                                   type="number"
                                   step="0.01"
                                   min="0.01"
                                   class="form-control" />

                        </div>

                        <span asp-validation-for="MontoPorDia"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <hr class="my-4" />

                <!-- BOTONES -->
                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-dark px-4">
                        Renovar reserva
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}