@model IEnumerable<AnaYAntonio_ProyectoInmobiliaria.Models.Reserva>

@{
    ViewData["Title"] = "Gestión de Reservas";

    var auditorias = ViewBag.Auditorias
        as Dictionary<int, IList<AnaYAntonio_ProyectoInmobiliaria.Models.Auditoria>>;
}

<div id="app" class="py-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Gestión inmobiliaria</h2>

            <p class="text-muted mb-0">
                Administre las reservas de inmuebles.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-dark px-4">
            <span class="me-1">+</span>
            Nueva reserva
        </a>

    </div>

    <!-- MENSAJE -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4"
             role="alert">

            <strong>¡Operación realizada correctamente!</strong>
            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }

    <!-- LISTADO -->
    <div class="card border-0 shadow-sm rounded-4">

        <!-- CABECERA -->
        <div class="card-body p-4 border-bottom">

            <div class="d-flex justify-content-between align-items-center mb-3">

                <h5 class="fw-semibold mb-0">
                    Listado de reservas
                </h5>

                <span class="text-muted small">
                    @ViewBag.CantidadTotal reserva(s)
                </span>

            </div>

            <!-- BUSCADOR -->
            <form method="get" asp-action="Index">

                <div class="row g-2">

                    <div class="col-md-10">

                        <input type="text"
                               name="buscar"
                               value="@ViewBag.Buscar"
                               class="form-control"
                               placeholder="Buscar por código, inquilino, DNI o dirección..." />

                    </div>

                    <div class="col-md-2 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-dark flex-grow-1">
                            Buscar
                        </button>

                        @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar))
                        {
                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Limpiar
                            </a>
                        }

                    </div>

                </div>

            </form>

        </div>

        <!-- TABLA -->
        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th class="ps-4">
                            Código
                        </th>

                        <th>
                            Inquilino
                        </th>

                        <th>
                            Inmueble
                        </th>

                        <th>
                            Fecha inicio
                        </th>

                        <th>
                            Fecha fin
                        </th>

                        <th>
                            Monto por día
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-end pe-4">
                            Acciones
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="8"
                                class="text-center py-5">

                                <div class="text-muted">

                                    @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar))
                                    {
                                        <h6 class="mb-2">
                                            No se encontraron reservas.
                                        </h6>

                                        <p class="mb-0">
                                            No hay reservas que coincidan con
                                            "<strong>@ViewBag.Buscar</strong>".
                                        </p>
                                    }
                                    else
                                    {
                                        <h6 class="mb-2">
                                            No hay reservas registradas.
                                        </h6>

                                        <p class="mb-0">
                                            Todavía no se registraron reservas.
                                        </p>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var reserva in Model)
                        {
                            <tr>

                                <!-- CÓDIGO -->
                                <td class="ps-4">

                                    <span class="fw-semibold text-muted">
                                        #@reserva.ID_reserva
                                    </span>

                                </td>

                                <!-- INQUILINO -->
                                <td>

                                    @{
                                        var inquilino =
                                            ((IEnumerable<AnaYAntonio_ProyectoInmobiliaria.Models.Inquilino>)
                                                ViewBag.Inquilinos)
                                            .FirstOrDefault(i =>
                                                i.ID_inquilino == reserva.ID_inquilino);
                                    }

                                    @if (inquilino != null)
                                    {
                                        @($"{inquilino.Nombre} {inquilino.Apellido}")
                                    }

                                </td>

                                <!-- INMUEBLE -->
                                <td>

                                    @{
                                        var inmueble =
                                            ((IEnumerable<AnaYAntonio_ProyectoInmobiliaria.Models.Inmueble>)
                                                ViewBag.Inmuebles)
                                            .FirstOrDefault(i =>
                                                i.ID_inmueble == reserva.ID_inmueble);
                                    }

                                    @if (inmueble != null)
                                    {
                                        @inmueble.Direccion
                                    }

                                </td>

                                <!-- FECHA INICIO -->
                                <td>
                                    @reserva.FechaInicio.ToString("dd/MM/yyyy")
                                </td>

                                <!-- FECHA FIN -->
                                <td>
                                    @reserva.FechaFin.ToString("dd/MM/yyyy")
                                </td>

                                <!-- MONTO -->
                                <td>
                                    <strong>
                                        $@reserva.MontoPorDia.ToString("N2")
                                    </strong>
                                </td>

                                <!-- ESTADO -->
                                <td>

                                    @if (reserva.Estado)
                                    {
                                        <span class="badge rounded-pill bg-success">
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-secondary">
                                            Inactiva
                                        </span>
                                    }

                                </td>

                                <!-- ACCIONES -->
                                <td class="text-end pe-4">

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm"
                                                v-on:click="alternarAuditoria(@reserva.ID_reserva)">

                                            {{ reservaAbierta === @reserva.ID_reserva
                                                ? 'Ocultar auditoría'
                                                : 'Auditoría' }}

                                        </button>
                                    }

                                    <a asp-action="Edit"
                                       asp-route-id="@reserva.ID_reserva"
                                       class="btn btn-outline-primary btn-sm ms-1">
                                        Modificar
                                    </a>

                                    @if (reserva.Estado)
                                    {
                                        <a asp-action="Renovar"
                                           asp-route-id="@reserva.ID_reserva"
                                           class="btn btn-outline-info btn-sm ms-1">
                                            Renovar
                                        </a>

                                        <a asp-action="FinalizarAnticipadamente"
                                           asp-route-id="@reserva.ID_reserva"
                                           class="btn btn-outline-warning btn-sm ms-1">
                                            Finalizar anticipadamente
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@reserva.ID_reserva"
                                              method="post"
                                              class="d-inline">

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm ms-1">
                                                Dar de baja
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate"
                                              asp-route-id="@reserva.ID_reserva"
                                              method="post"
                                              class="d-inline">

                                            <button type="submit"
                                                    class="btn btn-outline-success btn-sm ms-1">
                                                Dar de alta
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>

                            <!-- AUDITORÍA -->
                            @if (User.IsInRole("Administrador") &&
                                 auditorias != null &&
                                 auditorias.ContainsKey(reserva.ID_reserva))
                            {
                                <tr v-if="reservaAbierta === @reserva.ID_reserva">

                                    <td colspan="8"
                                        class="bg-light">

                                        <div class="p-4">

                                            <h6 class="fw-bold mb-3">
                                                Auditoría de la reserva
                                                #@reserva.ID_reserva
                                            </h6>

                                            @{
                                                var registros =
                                                    auditorias[reserva.ID_reserva];
                                            }

                                            @if (registros.Any())
                                            {
                                                <div class="table-responsive">

                                                    <table class="table table-sm table-bordered bg-white mb-0">

                                                        <thead class="table-light">

                                                            <tr>

                                                                <th>
                                                                    Usuario
                                                                </th>

                                                                <th>
                                                                    Acción
                                                                </th>

                                                                <th>
                                                                    Fecha
                                                                </th>

                                                            </tr>

                                                        </thead>

                                                        <tbody>

                                                            @foreach (var registro in registros)
                                                            {
                                                                <tr>

                                                                    <td>
                                                                        Usuario #@registro.NombreUsuario
                                                                    </td>

                                                                    <td>

                                                                        @if (registro.Accion == "CREACION")
                                                                        {
                                                                            <span class="badge bg-success">
                                                                                Creación
                                                                            </span>
                                                                        }
                                                                        else if (registro.Accion == "FINALIZACION")
                                                                        {
                                                                            <span class="badge bg-warning text-dark">
                                                                                Finalización
                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="badge bg-secondary">
                                                                                @registro.Accion
                                                                            </span>
                                                                        }

                                                                    </td>

                                                                    <td>
                                                                        @registro.Fecha.ToString("dd/MM/yyyy HH:mm:ss")
                                                                    </td>

                                                                </tr>
                                                            }

                                                        </tbody>

                                                    </table>

                                                </div>
                                            }
                                            else
                                            {
                                                <p class="text-muted mb-0">
                                                    No hay registros de auditoría para esta reserva.
                                                </p>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                    }

                </tbody>

            </table>

        </div>

        <!-- PAGINACIÓN -->
        @if (ViewBag.CantidadPaginas > 1)
        {
            <div class="card-footer bg-white border-0 py-3">

                <nav aria-label="Paginación de reservas">

                    <ul class="pagination justify-content-center mb-0">

                        <!-- ANTERIOR -->
                        <li class="page-item @(ViewBag.PaginaActual == 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual - 1)"
                               asp-route-buscar="@ViewBag.Buscar">
                                Anterior
                            </a>

                        </li>

                        <!-- NÚMEROS -->
                        @for (int i = 1; i <= ViewBag.CantidadPaginas; i++)
                        {
                            <li class="page-item @(ViewBag.PaginaActual == i ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pagina="@i"
                                   asp-route-buscar="@ViewBag.Buscar">
                                    @i
                                </a>

                            </li>
                        }

                        <!-- SIGUIENTE -->
                        <li class="page-item @(ViewBag.PaginaActual == ViewBag.CantidadPaginas ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pagina="@(ViewBag.PaginaActual + 1)"
                               asp-route-buscar="@ViewBag.Buscar">
                                Siguiente
                            </a>

                        </li>

                    </ul>

                </nav>

            </div>
        }

    </div>

</div>

<script src="https://unpkg.com/vue@3"></script>

<script>

    Vue.createApp({

        data() {

            return {
                reservaAbierta: null
            };

        },

        methods: {

            alternarAuditoria(id) {

                if (this.reservaAbierta === id) {

                    this.reservaAbierta = null;

                }
                else {

                    this.reservaAbierta = id;

                }

            }

        }

    }).mount('#app');

</script>