@model AnaYAntonio_ProyectoInmobiliaria.Models.Inquilino

@{
    ViewData["Title"] = "Modificar Inquilino";
}

<div class="container py-4">

    <!-- Encabezado -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Modificar Inquilino</h2>
        <p class="text-muted mb-0">
            Actualice la información del inquilino seleccionado.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <input type="hidden" asp-for="ID_inquilino" />

                <h5 class="fw-semibold mb-4">Información personal</h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Apellido" class="form-label fw-semibold"></label>
                        <input asp-for="Apellido" class="form-control" />
                        <span asp-validation-for="Apellido" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="DNI" class="form-label fw-semibold"></label>
                    <input asp-for="DNI" class="form-control" />
                    <span asp-validation-for="DNI" class="text-danger small"></span>
                </div>

                <hr class="my-4" />

                <h5 class="fw-semibold mb-4">Información de contacto</h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Telefono" class="form-label fw-semibold"></label>
                        <input asp-for="Telefono" class="form-control" />
                        <span asp-validation-for="Telefono" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Mail" class="form-label fw-semibold"></label>
                        <input asp-for="Mail" class="form-control" />
                        <span asp-validation-for="Mail" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <h5 class="fw-semibold mb-3">Estado</h5>

                <div class="mb-4">
                    <select asp-for="Estado" class="form-select">
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </select>
                </div>

                <!-- Botones -->
                <div class="d-flex justify-content-end gap-2 border-top pt-4">
                    <a asp-action="Index" class="btn btn-light border px-4">
                        Cancelar
                    </a>
                    <input type="submit" value="Guardar cambios" class="btn btn-primary px-4" />
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}