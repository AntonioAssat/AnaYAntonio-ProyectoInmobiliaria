@model AnaYAntonio_ProyectoInmobiliaria.Models.Inquilino

@{
    ViewData["Title"] = "Nuevo Inquilino";
}

<div class="py-4">

    <!-- ENCABEZADO -->
    <div class="mb-4">

        <p class="text-uppercase text-secondary fw-semibold mb-2"
           style="letter-spacing: 1.5px;">
            Gestión inmobiliaria
        </p>

        <h1 class="fw-semibold mb-2">
            Nuevo inquilino
        </h1>

        <p class="text-secondary mb-0">
            Completá los datos para registrar un inquilino.
        </p>

    </div>


    <!-- FORMULARIO -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-4 p-lg-5">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4">
            </div>


            <form asp-action="Create"
                  method="post"
                  class="row g-4">

                <!-- NOMBRE -->
                <div class="col-md-6">

                    <label asp-for="Nombre"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Nombre"
                           class="form-control"
                           placeholder="Ingresá el nombre" />

                    <span asp-validation-for="Nombre"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- APELLIDO -->
                <div class="col-md-6">

                    <label asp-for="Apellido"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Apellido"
                           class="form-control"
                           placeholder="Ingresá el apellido" />

                    <span asp-validation-for="Apellido"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- DNI -->
                <div class="col-md-6">

                    <label asp-for="DNI"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="DNI"
                           class="form-control"
                           placeholder="Ingresá el DNI" />

                    <span asp-validation-for="DNI"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- TELÉFONO -->
                <div class="col-md-6">

                    <label asp-for="Telefono"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Telefono"
                           class="form-control"
                           placeholder="Ingresá el teléfono" />

                    <span asp-validation-for="Telefono"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- MAIL -->
                <div class="col-12">

                    <label asp-for="Mail"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Mail"
                           type="email"
                           class="form-control"
                           placeholder="ejemplo@correo.com" />

                    <span asp-validation-for="Mail"
                          class="text-danger small d-block mt-1">
                    </span>

                </div>


                <!-- BOTONES -->
                <div class="col-12">

                    <hr class="my-2">

                    <div class="d-flex flex-column flex-sm-row
                                justify-content-between
                                gap-2
                                align-items-sm-center
                                pt-3">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">

                            ← Volver

                        </a>

                        <button type="submit"
                                class="btn btn-dark px-4">

                            Cargar inquilino

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}