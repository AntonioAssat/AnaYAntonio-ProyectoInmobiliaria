@model AnaYAntonio_ProyectoInmobiliaria.Models.Inquilino

@{
    ViewData["Title"] = "Nuevo Inquilino";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8 col-xl-7">

            <div class="card border-0 shadow rounded-4 overflow-hidden">

                <div class="card-header bg-primary text-white border-0 p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div>
                            <h1 class="h3 mb-1">Nuevo inquilino</h1>
                            <p class="mb-0 text-white-50">
                                Completá los datos para registrar un inquilino.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <form asp-action="Create" method="post" class="row g-3">

                        <!-- Nombre -->
                        <div class="col-md-6">
                            <label asp-for="Nombre"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control"
                                   placeholder="Ingresá el nombre" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger small d-block mt-1">
                            </span>
                        </div>

                        <!-- Apellido -->
                        <div class="col-md-6">
                            <label asp-for="Apellido"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Apellido"
                                   class="form-control"
                                   placeholder="Ingresá el apellido" />

                            <span asp-validation-for="Apellido"
                                  class="text-danger small d-block mt-1">
                            </span>
                        </div>

                        <!-- DNI -->
                        <div class="col-md-6">
                            <label asp-for="DNI"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="DNI"
                                   class="form-control"
                                   placeholder="Ingresá el DNI" />

                            <span asp-validation-for="DNI"
                                  class="text-danger small d-block mt-1">
                            </span>
                        </div>

                        <!-- Teléfono -->
                        <div class="col-md-6">
                            <label asp-for="Telefono"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Telefono"
                                   class="form-control"
                                   placeholder="Ingresá el teléfono" />

                            <span asp-validation-for="Telefono"
                                  class="text-danger small d-block mt-1">
                            </span>
                        </div>

                        <!-- Mail -->
                        <div class="col-12">
                            <label asp-for="Mail"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Mail"
                                   type="email"
                                   class="form-control"
                                   placeholder="ejemplo@correo.com" />

                            <span asp-validation-for="Mail"
                                  class="text-danger small d-block mt-1">
                            </span>
                        </div>

                        <!-- Botones -->
                        <div class="col-12 d-flex flex-column flex-sm-row
                                    justify-content-between gap-2
                                    align-items-sm-center mt-4 pt-3 border-top">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                ← Volver
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Cargar inquilino
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}