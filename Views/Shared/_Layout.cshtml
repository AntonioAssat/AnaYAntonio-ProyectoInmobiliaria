<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Inmobiliaria A&A</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/AnaYAntonio_ProyectoInmobiliaria.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                <a class="navbar-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    Inmobiliaria A&A

                </a>


                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- MENÚ PRINCIPAL -->

                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Propietarios"
                               asp-action="Index">

                                Propietarios

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Inquilinos"
                               asp-action="Index">

                                Inquilinos

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Inmuebles"
                               asp-action="Index">

                                Inmuebles

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="TipoInmuebles"
                               asp-action="Index">

                                Tipos de Inmuebles

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Reserva"
                               asp-action="Index">

                                Reservas

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link text-dark"
                               asp-controller="Pago"
                               asp-action="Index">

                                Pagos

                            </a>

                        </li>


                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated &&
                             User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">

                                <a class="nav-link text-dark"
                                   asp-controller="Usuario"
                                   asp-action="Index">

                                    Usuarios

                                </a>

                            </li>
                        }

                    </ul>


                    <!-- USUARIO / LOGIN -->

                    <ul class="navbar-nav">

                        @if (User.Identity != null &&
                             User.Identity.IsAuthenticated)
                        {

                            <li class="nav-item d-flex align-items-center">

                                <span class="nav-link text-dark">

                                    Hola,
                                    @(User.FindFirst("FullName")?.Value
                                        ?? User.Identity.Name)

                                    (@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)

                                </span>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link text-danger"
                                   asp-controller="Usuario"
                                   asp-action="Logout">

                                    Cerrar sesión

                                </a>

                            </li>

                        }
                        else
                        {

                            <li class="nav-item">

                                <a class="nav-link text-primary"
                                   asp-controller="Usuario"
                                   asp-action="Login">

                                    Iniciar sesión

                                </a>

                            </li>

                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <!-- CONTENIDO PRINCIPAL -->

    <div class="container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- FOOTER -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - AnaYAntonio_ProyectoInmobiliaria -

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>


    <!-- SCRIPTS -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>