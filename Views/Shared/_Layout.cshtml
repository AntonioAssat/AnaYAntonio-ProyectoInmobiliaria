<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Inmobiliaria A&A
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/AnaYAntonio_ProyectoInmobiliaria.styles.css"
          asp-append-version="true" />

</head>


<body>


    <!-- =====================================================
         VUE DEL MENÚ
         IMPORTANTE:
         SOLO EL MENÚ ESTÁ DENTRO DE menuApp
         ===================================================== -->

    <div id="menuApp">


        <!-- =================================================
             BARRA SUPERIOR
             ================================================= -->

        <header>

            <nav class="top-navbar">


                <div class="navbar-left">


                    <!-- BOTÓN MENÚ -->

                    <button type="button"
                            class="menu-button"
                            aria-label="Abrir menú"
                            @@click="abrirMenu">

                        ☰

                    </button>


                    <!-- NOMBRE -->

                    <a class="navbar-brand-custom"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">

                        Inmobiliaria A&A

                    </a>


                </div>


                <!-- =================================================
                     USUARIO
                     ================================================= -->

                <div class="navbar-user">

                    @if (User.Identity != null &&
                         User.Identity.IsAuthenticated)
                    {
                        <span>

                            Hola,
                            @(User.FindFirst("FullName")?.Value
                                ?? User.Identity.Name)

                            <span class="user-role">

                                (@User.FindFirst(
                                    System.Security.Claims.ClaimTypes.Role
                                )?.Value)

                            </span>

                        </span>
                    }
                    else
                    {
                        <a asp-controller="Usuario"
                           asp-action="Login">

                            Iniciar sesión

                        </a>
                    }

                </div>

            </nav>

        </header>


        <!-- =================================================
             OVERLAY
             ================================================= -->

        <div class="menu-overlay"
             :class="{ 'overlay-open': menuAbierto }"
             @@click="cerrarMenu">
        </div>


        <!-- =================================================
             MENÚ LATERAL
             ================================================= -->

        <aside class="side-menu"
               :class="{ 'menu-open': menuAbierto }">


            <!-- CABECERA -->

            <div class="side-menu-header">

                <span>
                    Menú
                </span>


                <button type="button"
                        class="close-menu"
                        aria-label="Cerrar menú"
                        @@click="cerrarMenu">

                    ×

                </button>

            </div>


            <!-- OPCIONES -->

            <div class="side-menu-content">


                <!-- =================================================
                     INICIO
                     ================================================= -->

                <a class="side-menu-link"
                   asp-controller="Home"
                   asp-action="Index"
                   @@click="cerrarMenu">

                    <span class="menu-icon">
                        ⌂
                    </span>

                    <span>
                        Inicio
                    </span>

                </a>


                <!-- =================================================
                     PERSONAS
                     ================================================= -->

                <div class="menu-group">


                    <button type="button"
                            class="side-menu-link menu-dropdown"
                            @@click="personasAbierto = !personasAbierto">

                        <span class="menu-icon">
                            ♙
                        </span>

                        <span>
                            Personas
                        </span>

                        <span class="dropdown-arrow"
                              :class="{
                                  'arrow-open': personasAbierto
                              }">

                            ›

                        </span>

                    </button>


                    <div class="submenu"
                         :class="{
                             'submenu-open': personasAbierto
                         }">


                        <a asp-controller="Propietarios"
                           asp-action="Index"
                           @@click="cerrarMenu">

                            Propietarios

                        </a>


                        <a asp-controller="Inquilinos"
                           asp-action="Index"
                           @@click="cerrarMenu">

                            Inquilinos

                        </a>


                    </div>

                </div>


                <!-- =================================================
                     INMUEBLES
                     ================================================= -->

                <div class="menu-group">


                    <button type="button"
                            class="side-menu-link menu-dropdown"
                            @@click="inmueblesAbierto = !inmueblesAbierto">

                        <span class="menu-icon">
                            ⌂
                        </span>

                        <span>
                            Inmuebles
                        </span>

                        <span class="dropdown-arrow"
                              :class="{
                                  'arrow-open': inmueblesAbierto
                              }">

                            ›

                        </span>

                    </button>


                    <div class="submenu"
                         :class="{
                             'submenu-open': inmueblesAbierto
                         }">


                        <a asp-controller="Inmuebles"
                           asp-action="Index"
                           @@click="cerrarMenu">

                            Inmuebles

                        </a>


                        <a asp-controller="TipoInmuebles"
                           asp-action="Index"
                           @@click="cerrarMenu">

                            Tipos de Inmuebles

                        </a>


                    </div>

                </div>


                <!-- =================================================
                     RESERVAS
                     ================================================= -->

                <a class="side-menu-link"
                   asp-controller="Reserva"
                   asp-action="Index"
                   @@click="cerrarMenu">

                    <span class="menu-icon">
                        ▣
                    </span>

                    <span>
                        Reservas
                    </span>

                </a>


                <!-- =================================================
                     PAGOS
                     ================================================= -->

                <a class="side-menu-link"
                   asp-controller="Pago"
                   asp-action="Index"
                   @@click="cerrarMenu">

                    <span class="menu-icon">
                        $
                    </span>

                    <span>
                        Pagos
                    </span>

                </a>


                <!-- =================================================
                     INFORMES
                     SOLO ADMINISTRADOR
                     ================================================= -->

                @if (User.Identity != null &&
                     User.Identity.IsAuthenticated &&
                     User.IsInRole("Administrador"))
                {
                    <a class="side-menu-link"
                       asp-controller="Informes"
                       asp-action="Index"
                       @@click="cerrarMenu">

                        <span class="menu-icon">
                            ▤
                        </span>

                        <span>
                            Informes
                        </span>

                    </a>
                }


                <!-- =================================================
                     USUARIOS
                     SOLO ADMINISTRADOR
                     ================================================= -->

                @if (User.Identity != null &&
                     User.Identity.IsAuthenticated &&
                     User.IsInRole("Administrador"))
                {
                    <a class="side-menu-link"
                       asp-controller="Usuario"
                       asp-action="Index"
                       @@click="cerrarMenu">

                        <span class="menu-icon">
                            ♙
                        </span>

                        <span>
                            Usuarios
                        </span>

                    </a>
                }


                <!-- =================================================
                     SEPARADOR
                     ================================================= -->

                <div class="menu-separator"></div>


                <!-- =================================================
                     PERFIL Y LOGOUT
                     ================================================= -->

                @if (User.Identity != null &&
                     User.Identity.IsAuthenticated)
                {


                    <!-- MI PERFIL -->

                    <a class="side-menu-link"
                       asp-controller="Usuario"
                       asp-action="Perfil"
                       @@click="cerrarMenu">

                        <span class="menu-icon">
                            ◉
                        </span>

                        <span>
                            Mi Perfil
                        </span>

                    </a>


                    <!-- CERRAR SESIÓN -->

                    <a class="side-menu-link logout-link"
                       asp-controller="Usuario"
                       asp-action="Logout">

                        <span class="menu-icon">
                            ↪
                        </span>

                        <span>
                            Cerrar sesión
                        </span>

                    </a>

                }


            </div>

        </aside>


    </div>


    <!-- =====================================================
         CONTENIDO DE LAS VISTAS
         
         MUY IMPORTANTE:
         ESTO ESTÁ FUERA DE #menuApp
         ===================================================== -->

    <div class="container main-container">

        <main role="main"
              class="pb-3">

            @RenderBody()

        </main>

    </div>


    <!-- =====================================================
         FOOTER
         ===================================================== -->

    <footer class="border-top footer text-muted">

        <div class="container">

            &copy; 2026 - AnaYAntonio_ProyectoInmobiliaria -

            <a asp-area=""
               asp-controller="Home"
               asp-action="Privacy">

                Privacy

            </a>

        </div>

    </footer>


    <!-- =====================================================
         SCRIPTS
         ===================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- VUE 3 -->

    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>


    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <!-- =====================================================
         VUE DEL MENÚ
         ===================================================== -->

    <script>

        const { createApp } = Vue;

        createApp({

            data() {

                return {

                    menuAbierto: false,

                    personasAbierto: false,

                    inmueblesAbierto: false

                };

            },


            methods: {

                abrirMenu() {

                    this.menuAbierto = true;

                },


                cerrarMenu() {

                    this.menuAbierto = false;

                    this.personasAbierto = false;

                    this.inmueblesAbierto = false;

                }

            }

        }).mount("#menuApp");

    </script>


    <!-- =====================================================
         SCRIPTS DE CADA VISTA
         ===================================================== -->

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )


</body>

</html>