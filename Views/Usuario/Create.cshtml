@model AnaYAntonio_ProyectoInmobiliaria.Models.Usuario

@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="container py-4">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            Nuevo Usuario
        </h2>

        <p class="text-muted mb-0">
            Registre un nuevo usuario del sistema.
        </p>

    </div>


    <div class="card shadow-sm">

        <div class="card-header bg-white py-3">

            <h5 class="mb-0 fw-semibold">
                Datos del Usuario
            </h5>

        </div>


        <div class="card-body p-4">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="row g-3">

                    <!-- NOMBRE -->

                    <div class="col-md-6">

                        <label asp-for="Nombre"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Nombre"
                               class="form-control"
                               placeholder="Ingrese el nombre" />

                        <span asp-validation-for="Nombre"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- APELLIDO -->

                    <div class="col-md-6">

                        <label asp-for="Apellido"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Apellido"
                               class="form-control"
                               placeholder="Ingrese el apellido" />

                        <span asp-validation-for="Apellido"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- EMAIL -->

                    <div class="col-md-6">

                        <label asp-for="Email"
                               class="form-label fw-semibold">
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="correo@ejemplo.com" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CONTRASEÑA -->

                    <div class="col-md-6">

                        <label asp-for="Clave"
                               class="form-label fw-semibold">
                            Contraseña
                        </label>

                        <input asp-for="Clave"
                               type="password"
                               class="form-control"
                               placeholder="Ingrese una contraseña" />

                        <span asp-validation-for="Clave"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ROL -->

                    <div class="col-md-6">

                        <label asp-for="Rol"
                               class="form-label fw-semibold">
                            Rol
                        </label>

                        <select asp-for="Rol"
                                class="form-select">

                            <option value="">
                                Seleccione un rol
                            </option>

                            @foreach (var rol in ViewBag.Roles)
                            {
                                <option value="@rol.Key">
                                    @rol.Value
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Rol"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr class="my-4" />


                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary px-4">

                        Cancelar

                    </a>


                    <button type="submit"
                            class="btn btn-primary px-4">

                        Guardar Usuario

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}