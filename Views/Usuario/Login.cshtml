@model AnaYAntonio_ProyectoInmobiliaria.Models.LoginView

@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

            <div class="card shadow-sm">

                <div class="card-header bg-white text-center py-4">

                    <h2 class="fw-bold mb-1">
                        Iniciar sesión
                    </h2>

                    <p class="text-muted mb-0">
                        Ingrese sus datos para acceder al sistema.
                    </p>

                </div>

                <div class="card-body p-4">

                    <form asp-action="Login"
                          method="post">

                        <input type="hidden"
                               name="returnUrl"
                               value="@ViewBag.ReturnUrl" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <!-- EMAIL -->

                        <div class="mb-3">

                            <label asp-for="Usuario"
                                   class="form-label fw-semibold">
                                Email
                            </label>

                            <input asp-for="Usuario"
                                   class="form-control"
                                   placeholder="ejemplo@email.com"
                                   autocomplete="email" />

                            <span asp-validation-for="Usuario"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- CONTRASEÑA -->

                        <div class="mb-4">

                            <label asp-for="Clave"
                                   class="form-label fw-semibold">
                                Contraseña
                            </label>

                            <input asp-for="Clave"
                                   class="form-control"
                                   autocomplete="current-password" />

                            <span asp-validation-for="Clave"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="d-grid">

                            <button type="submit"
                                    class="btn btn-primary py-2">

                                Ingresar

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }

}