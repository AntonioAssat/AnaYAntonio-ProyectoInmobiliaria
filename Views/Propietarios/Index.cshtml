@model IEnumerable<AnaYAntonio_ProyectoInmobiliaria.Models.Propietario>

@{
    ViewData["Title"] = "Gestión de Propietarios";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int cantidadPaginas = ViewBag.CantidadPaginas ?? 0;
    int cantidadTotal = ViewBag.CantidadTotal ?? 0;
    string buscar = ViewBag.Buscar ?? "";
}

<div class="py-4">

    <!-- ENCABEZADO -->
    <div class="d-flex flex-column flex-md-row
                justify-content-between
                align-items-md-center
                gap-3
                mb-4">

        <div>

            <p class="text-uppercase text-secondary fw-semibold mb-2"
               style="letter-spacing: 1.5px;">
                Gestión inmobiliaria
            </p>

            <h1 class="fw-semibold mb-2">
                Propietarios
            </h1>

            <p class="text-secondary mb-0">
                Administración de los propietarios registrados.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-dark">

            + Nuevo propietario

        </a>

    </div>


    <!-- MENSAJE -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show
                    border-0 shadow-sm rounded-3 mb-4"
             role="alert">

            <strong>¡Operación realizada correctamente!</strong>
            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>

        </div>
    }


    <!-- BUSCADOR -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">

        <div class="card-body p-4">

            <form asp-action="Index"
                  method="get"
                  class="row g-3 align-items-end">

                <div class="col-12 col-md-9">

                    <label for="buscar"
                           class="form-label fw-semibold">

                        Buscar propietario

                    </label>

                    <input type="text"
                           id="buscar"
                           name="buscar"
                           value="@buscar"
                           class="form-control"
                           placeholder="Nombre, apellido, DNI, teléfono o mail..." />

                </div>

                <div class="col-12 col-md-3 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-dark flex-grow-1">

                        Buscar

                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Limpiar

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- CANTIDAD DE RESULTADOS -->
    @if (cantidadTotal > 0)
    {
        <div class="text-secondary mb-3">

            Se encontraron
            <strong>@cantidadTotal</strong>
            propietario(s).

        </div>
    }


    <!-- TABLA -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-4">

            <div class="d-flex
                        justify-content-between
                        align-items-center">

                <h2 class="h5 fw-semibold mb-0">
                    Listado de propietarios
                </h2>

                <span class="text-secondary small">
                    @cantidadTotal registro(s)
                </span>

            </div>

        </div>


        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th class="ps-4">
                            Código
                        </th>

                        <th>
                            Nombre completo
                        </th>

                        <th>
                            DNI
                        </th>

                        <th>
                            Contacto
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="text-end pe-4">
                            Acciones
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center py-5">

                                <div class="text-secondary">

                                    <div class="fs-1 mb-3">
                                        👤
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(buscar))
                                    {
                                        <h3 class="h5 mb-2">
                                            No se encontraron propietarios
                                        </h3>

                                        <p class="mb-3">

                                            No hay propietarios que coincidan con
                                            "<strong>@buscar</strong>".

                                        </p>

                                        <a asp-action="Index"
                                           class="btn btn-outline-secondary">

                                            Limpiar búsqueda

                                        </a>
                                    }
                                    else
                                    {
                                        <h3 class="h5 mb-2">
                                            No hay propietarios registrados
                                        </h3>

                                        <p class="mb-3">
                                            Todavía no se registraron propietarios
                                            en el sistema.
                                        </p>

                                        <a asp-action="Create"
                                           class="btn btn-dark">

                                            + Nuevo propietario

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                    else
                    {
                        @foreach (var propietario in Model)
                        {
                            <tr>

                                <!-- CÓDIGO -->
                                <td class="ps-4">

                                    <span class="text-secondary">
                                        #@propietario.ID_propietario
                                    </span>

                                </td>


                                <!-- NOMBRE -->
                                <td>

                                    <div class="fw-semibold">
                                        @propietario.Nombre @propietario.Apellido
                                    </div>

                                </td>


                                <!-- DNI -->
                                <td>
                                    @propietario.DNI
                                </td>


                                <!-- CONTACTO -->
                                <td>

                                    <div>
                                        @propietario.Telefono
                                    </div>

                                    <small class="text-secondary">
                                        @propietario.Mail
                                    </small>

                                </td>


                                <!-- ESTADO -->
                                <td>

                                    @if (propietario.Estado)
                                    {
                                        <span class="badge text-bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            Inactivo
                                        </span>
                                    }

                                </td>


                                <!-- ACCIONES -->
                                <td class="text-end pe-4">

                                    <div class="d-flex
                                                justify-content-end
                                                gap-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@propietario.ID_propietario"
                                           class="btn btn-outline-secondary btn-sm">

                                            Modificar

                                        </a>


                                        @if (propietario.Estado)
                                        {
                                            <form asp-action="Delete"
                                                  asp-route-id="@propietario.ID_propietario"
                                                  method="post"
                                                  class="d-inline">

                                                <button type="submit"
                                                        class="btn btn-outline-danger btn-sm">

                                                    Dar de baja

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="Activate"
                                                  asp-route-id="@propietario.ID_propietario"
                                                  method="post"
                                                  class="d-inline">

                                                <button type="submit"
                                                        class="btn btn-outline-success btn-sm">

                                                    Dar de alta

                                                </button>

                                            </form>
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>


        <!-- PAGINACIÓN -->
        @if (cantidadPaginas > 1)
        {
            <div class="card-footer bg-white border-0 py-4">

                <nav aria-label="Paginación de propietarios">

                    <ul class="pagination justify-content-center mb-0">

                        <!-- ANTERIOR -->
                        <li class="page-item
                                   @(paginaActual <= 1 ? "disabled" : "")">

                            @if (paginaActual > 1)
                            {
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-buscar="@buscar"
                                   asp-route-pagina="@(paginaActual - 1)">

                                    ← Anterior

                                </a>
                            }
                            else
                            {
                                <span class="page-link">
                                    ← Anterior
                                </span>
                            }

                        </li>


                        <!-- NÚMEROS -->
                        @for (int i = 1; i <= cantidadPaginas; i++)
                        {
                            <li class="page-item
                                       @(i == paginaActual ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-buscar="@buscar"
                                   asp-route-pagina="@i">

                                    @i

                                </a>

                            </li>
                        }


                        <!-- SIGUIENTE -->
                        <li class="page-item
                                   @(paginaActual >= cantidadPaginas ? "disabled" : "")">

                            @if (paginaActual < cantidadPaginas)
                            {
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-buscar="@buscar"
                                   asp-route-pagina="@(paginaActual + 1)">

                                    Siguiente →

                                </a>
                            }
                            else
                            {
                                <span class="page-link">
                                    Siguiente →
                                </span>
                            }

                        </li>

                    </ul>

                </nav>

            </div>
        }

    </div>

</div>