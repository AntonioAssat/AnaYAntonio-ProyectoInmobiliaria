@model IEnumerable<AnaYAntonio_ProyectoInmobiliaria.Models.Propietario>

@{
    ViewData["Title"] = "Gestión de Propietarios";
}

<div class="container-fluid py-4">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Gestión de Propietarios</h2>
            <p class="text-muted mb-0">
                Administre la información y el estado de los propietarios registrados.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4 py-2">
            <span class="me-1">+</span> Nuevo Propietario
        </a>
    </div>

    <!-- Mensaje de operación realizada -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <strong>¡Operación realizada correctamente!</strong> @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <!-- Contenedor de la tabla -->
    <div class="card shadow-sm">

        <div class="card-header bg-white py-3">
            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-semibold">
                    Listado de Propietarios
                </h5>

                <span class="text-muted small">
                    @Model.Count() registro(s)
                </span>

            </div>
        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Código</th>
                        <th>Nombre completo</th>
                        <th>DNI</th>
                        <th>Contacto</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var propietario in Model)
                    {
                        <tr>

                            <!-- Código -->
                            <td class="ps-4">
                                <span class="text-muted">
                                    #@propietario.ID_propietario
                                </span>
                            </td>

                            <!-- Nombre -->
                            <td>
                                <div class="fw-semibold">
                                    @propietario.Nombre @propietario.Apellido
                                </div>
                            </td>

                            <!-- DNI -->
                            <td>
                                @propietario.DNI
                            </td>

                            <!-- Contacto -->
                            <td>
                                <div>@propietario.Telefono</div>
                                <small class="text-muted">
                                    @propietario.Mail
                                </small>
                            </td>

                            <!-- Estado -->
                            <td>
                                @if (propietario.Estado)
                                {
                                    <span class="badge rounded-pill bg-success">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-secondary">
                                        Inactivo
                                    </span>
                                }
                            </td>

                            <!-- Acciones -->
                            <td class="text-end pe-4">

                                <a asp-action="Edit"
                                   asp-route-id="@propietario.ID_propietario"
                                   class="btn btn-outline-primary btn-sm">
                                    Modificar
                                </a>

                                @if (propietario.Estado)
                                {
                                    <form asp-action="Delete"
                                          asp-route-id="@propietario.ID_propietario"
                                          method="post"
                                          class="d-inline">

                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm ms-1">
                                            Dar de baja
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate"
                                          asp-route-id="@propietario.ID_propietario"
                                          method="post"
                                          class="d-inline">

                                        <button type="submit"
                                                class="btn btn-outline-success btn-sm ms-1">
                                            Dar de alta
                                        </button>

                                    </form>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

</div>