@model AnaYAntonio_ProyectoInmobiliaria.Models.TipoInmueble

@{
    ViewData["Title"] = "Nuevo tipo de inmueble";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-7 col-lg-5">

            <div class="card border-0 shadow rounded-4 overflow-hidden">

                <div class="card-header bg-primary text-white border-0 p-4">
                    <h1 class="h3 mb-1">Nuevo tipo de inmueble</h1>

                    <p class="mb-0 text-white-50">
                        Agregá un tipo de inmueble.
                    </p>
                </div>

                <div class="card-body p-4">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <form asp-action="Create" method="post">

                        <div class="mb-4">

                            <label asp-for="Nombre"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Nombre"
                                   class="form-control"
                                   placeholder="Ej. Casa" />

                            <span asp-validation-for="Nombre"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                ← Volver
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                Guardar
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}