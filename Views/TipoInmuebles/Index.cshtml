@model IList<AnaYAntonio_ProyectoInmobiliaria.Models.TipoInmueble>

@{
    ViewData["Title"] = "Tipos de inmueble";

    int paginaActual = ViewBag.PaginaActual ?? 1;
    int cantidadPaginas = ViewBag.CantidadPaginas ?? 0;
    int cantidadTotal = ViewBag.CantidadTotal ?? 0;
    string buscar = ViewBag.Buscar ?? "";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1">Tipos de inmueble</h1>
            <p class="text-muted mb-0">
                Administrá los tipos disponibles para los inmuebles.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Nuevo tipo
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Mensaje"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <!-- Buscador -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-2">

                    <div class="col-md-10">
                        <input type="text"
                               name="buscar"
                               value="@buscar"
                               class="form-control"
                               placeholder="Buscar tipo de inmueble..." />
                    </div>

                    <div class="col-md-2 d-grid">
                        <button type="submit"
                                class="btn btn-primary">
                            Buscar
                        </button>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <div class="card border-0 shadow rounded-4 overflow-hidden">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-semibold">
                    Listado de tipos de inmueble
                </h5>

                <span class="text-muted small">
                    @cantidadTotal registro(s)
                </span>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Nombre</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var tipo in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @tipo.Nombre
                                </td>

                                <td>

                                    @if (tipo.Estado)
                                    {
                                        <span class="badge text-bg-success">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">
                                            Inactivo
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <a asp-action="Edit"
                                       asp-route-id="@tipo.ID_tipo"
                                       class="btn btn-outline-primary btn-sm">
                                        Editar
                                    </a>

                                    @if (tipo.Estado)
                                    {
                                        <form asp-action="Baja"
                                              asp-route-id="@tipo.ID_tipo"
                                              method="post"
                                              class="d-inline">

                                            <button type="submit"
                                                    class="btn btn-outline-danger btn-sm ms-1">
                                                Dar de baja
                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="AltaEstado"
                                              asp-route-id="@tipo.ID_tipo"
                                              method="post"
                                              class="d-inline">

                                            <button type="submit"
                                                    class="btn btn-outline-success btn-sm ms-1">
                                                Dar de alta
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3"
                                class="text-center text-muted py-4">
                                No se encontraron tipos de inmueble.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- Paginación -->
        @if (cantidadPaginas > 1)
        {
            <div class="card-footer bg-white">

                <nav aria-label="Paginación">

                    <ul class="pagination justify-content-center mb-0">

                        <!-- Anterior -->
                        <li class="page-item @(paginaActual == 1 ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-buscar="@buscar"
                               asp-route-pagina="@(paginaActual - 1)">
                                Anterior
                            </a>

                        </li>

                        <!-- Números de página -->
                        @for (int i = 1; i <= cantidadPaginas; i++)
                        {
                            <li class="page-item @(i == paginaActual ? "active" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-buscar="@buscar"
                                   asp-route-pagina="@i">
                                    @i
                                </a>

                            </li>
                        }

                        <!-- Siguiente -->
                        <li class="page-item @(paginaActual == cantidadPaginas ? "disabled" : "")">

                            <a class="page-link"
                               asp-action="Index"
                               asp-route-buscar="@buscar"
                               asp-route-pagina="@(paginaActual + 1)">
                                Siguiente
                            </a>

                        </li>

                    </ul>

                </nav>

            </div>
        }

    </div>

</div>